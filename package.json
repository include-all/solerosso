{
  "name": "solerosso",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "client:start": "cd packages/client && npm start",
    "client:build": "cd packages/client && npm run build",
    "lint": "cd packages/client && npm run lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.0",
    "typescript": "~4.5.4"
  }
}
